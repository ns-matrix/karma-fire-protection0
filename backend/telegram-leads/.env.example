# =============================================================================
# KARMA FIRE PROTECTION LLP — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to ".env" inside backend/telegram-leads/ or your root deployment
# NEVER commit the real .env file with secrets into version control.
# =============================================================================

# ---------- Server Configuration ----------
PORT=3000
NODE_ENV=production

# Comma-separated list of allowed browser origins for CORS (leave empty for same-origin only).
# Example: https://www.karmafireprotection.com,https://karmafireprotection.com
ALLOWED_ORIGINS=https://www.karmafireprotection.com,https://karmafireprotection.com

# Public site URL (for absolute links in emails, etc.)
PUBLIC_SITE_URL=https://www.karmafireprotection.com

# ---------- CSV Data Storage ----------
# Directory where CSV files are stored (leads.csv, activity.csv)
CSV_DATA_DIR=./data

# ---------- Admin Dashboard Authentication ----------
# Default credentials are built into the app and stored only as a PBKDF2 hash
# (safe to commit). Login: Karma@Admin@123
# Optionally override them here (plaintext stays in this git-ignored file):
# ADMIN_USER_ID=your_admin_user
# ADMIN_PASSWORD=your_admin_password

# Session secret for HMAC token signing (min 64 chars, generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# If unset, a random secret is generated at boot (sessions reset on restart).
SESSION_SECRET=generate_a_long_random_secret_string_for_signing_hmac_tokens_at_least_64_chars

# ---------- Telegram Lead CRM Bot ----------
# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Notification Chat ID where new leads should be posted (group chat or private chat)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Comma-separated list of Telegram user IDs allowed to run CRM bot commands (/leads, /stats, /export, etc.)
ADMIN_TELEGRAM_IDS=your_telegram_user_id_here

# ---------- Email Notifications (Nodemailer / SMTP) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username_or_email@gmail.com
SMTP_PASS=your_smtp_app_password_here
EMAIL_FROM="Karma Fire Protection" <leads@karmafireprotection.com>
EMAIL_TO=karmafireprotectionllp@gmail.com

# ---------- Google Sheets Integration (Link Only) ----------
# URL of Google Sheet to link from admin dashboard (no auto-sync, manual export/import)
GOOGLE_SHEETS_URL=https://docs.google.com/spreadsheets/d/your_sheet_id_here

# ---------- Analytics Integration (Optional) ----------
# Google Analytics 4 Measurement ID
GA4_MEASUREMENT_ID=G-XXXXXXXXXX